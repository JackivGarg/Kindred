# Leave BOTH values empty to use the local demonstration.
# Copy this file to .env.local when connecting your own Supabase project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_URL=

# Use the public sb_publishable_ key from Supabase Project Settings > API Keys.
# Never use sb_secret_ or service_role credentials in a VITE_ variable.
# Configure Auth Site URL and allowed redirect URLs to match the application origin.
# Production: set VITE_APP_URL=https://YOUR_HOST (origin only, no path).
# Allow exactly https://YOUR_HOST/auth/callback in Supabase Auth redirect URLs.
